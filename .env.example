# forecast – environment variables
# Copy to .env and fill in real values for local development:
#   cp .env.example .env

# Database (async driver for the app, sync driver for Alembic)
DATABASE_URL=postgresql+asyncpg://forecast:forecast@localhost:5432/forecast
SYNC_DATABASE_URL=postgresql+psycopg2://forecast:forecast@localhost:5432/forecast

# Redis
REDIS_URL=redis://localhost:6379

# S3 / Object Storage
S3_BUCKET=forecast-zarr
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_ENDPOINT_URL=http://localhost:9000

# STAC
STAC_API_URL=https://planetarycomputer.microsoft.com/api/stac/v1
